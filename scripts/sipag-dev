#!/usr/bin/env bash
# sipag-dev — fast iteration loop for sipag.
#
# - Stops the launchd-managed prod sipag (so port 7100 is free).
# - Runs `cargo watch` against a debug build with SIPAG_DEV=1.
# - Pipes the same env vars + cli args the prod plist uses, so the
#   tunnel + browser POV is identical to prod.
# - On Ctrl-C: bootstraps prod sipag back so sipag.felixflor.es keeps
#   working when you walk away.
#
# Iteration cycle with this running:
#   - .rs change          → cargo rebuilds (debug, ~5-10s) → restart → iPad auto-refreshes (livereload)
#   - web/public/* change → no rebuild; just refresh the iPad
#
# Usage:  scripts/sipag-dev
# Stop:   Ctrl-C in the running shell

set -euo pipefail

LABEL="com.dorkyrobot.sipag"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

if ! command -v cargo-watch >/dev/null 2>&1; then
  echo "cargo-watch not installed — run: cargo install cargo-watch" >&2
  exit 1
fi

uid=$(id -u)
service="gui/$uid/$LABEL"

# Capture whether prod is currently loaded so we can restore it.
prod_was_loaded=0
if launchctl print "$service" >/dev/null 2>&1; then
  prod_was_loaded=1
fi

restore_prod() {
  if [[ "$prod_was_loaded" -eq 1 ]] && [[ -f "$PLIST" ]]; then
    echo
    echo "[sipag-dev] restoring prod sipag…"
    launchctl bootstrap "gui/$uid" "$PLIST" 2>/dev/null || true
  fi
}
trap restore_prod EXIT INT TERM

if [[ "$prod_was_loaded" -eq 1 ]]; then
  echo "[sipag-dev] stopping prod sipag…"
  launchctl bootout "$service" 2>/dev/null || true
  # bootout returns immediately even though tear-down is async — give
  # the OS a beat to release port 7100.
  sleep 2
fi

# Same env the prod plist uses so /sessions, ollama, public URL, etc.
# all behave identically. SIPAG_DEV=1 enables the tower-livereload
# layer in build_router_inner.
export SIPAG_DEV=1
export PORT=7100
export KATULONG_DATA_DIR="$HOME/.sipag"
export OLLAMA_HOST="https://ollama-mac2024.felixflor.es"
export OLLAMA_MODEL="gemma4:31b"
export OLLAMA_AUTH="@$HOME/.sipag/ollama-bridge.token"
export SIPAG_PUBLIC_URL="https://sipag.felixflor.es"
export RUST_LOG="${RUST_LOG:-sipag=info,tower_http=info}"

echo "[sipag-dev] starting cargo watch (debug build, SIPAG_DEV=1)…"
echo "[sipag-dev] save a .rs file → rebuild + restart + iPad auto-refresh"
echo "[sipag-dev] Ctrl-C to stop and restore prod sipag"
echo

# `-x run` already restarts on rebuild because cargo watch kills the
# previous process before launching the new one. We deliberately do
# NOT watch web/public/ here — sipag's own livereload watcher (notify
# crate) handles static changes without a server restart, which is
# faster and doesn't break in-progress requests.
exec cargo watch \
  --watch sipag \
  --watch sipag-core \
  -x "run --bin sipag -- serve --port 7100 --web-root web/public --workers"
